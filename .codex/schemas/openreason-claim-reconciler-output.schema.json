{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceClaimId": { "type": "string", "minLength": 1 },
          "targetClaimId": { "type": "string", "minLength": 1 },
          "relationship": {
            "type": "string",
            "enum": [
              "duplicate",
              "supports",
              "contradicts",
              "qualifies",
              "same_topic",
              "different_time",
              "different_speaker",
              "unresolved"
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "required": [
          "sourceClaimId",
          "targetClaimId",
          "relationship",
          "confidence",
          "rationale"
        ]
      }
    }
  },
  "required": ["documentId", "decisions"]
}
